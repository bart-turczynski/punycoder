# R package development
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# Cached upstream UCD files for data-raw/generate_unicode_tables.R (re-downloaded
# on demand). The generated src/unicode_tables_*.cpp is committed; these are not.
data-raw/.ucd-cache/

# Same, for data-raw/fetch_idna_fixtures.R: the vendored
# inst/testdata/IdnaTestV2-*.txt corpora are committed, the downloads are not.
data-raw/.idna-cache/

# Compiled Object files
*.o
*.so
*.dll

# R CMD check results
*.Rcheck/

# revdepcheck::revdep_check() working tree: a SQLite db, a cloned library, and a
# full build of every reverse dependency. Regenerated on demand, hundreds of MB.
# The revdep/*.md reports it emits are summaries of a run, not source.
revdep/
# Stray top-level copy of tests/ that R CMD check can leave behind. Not source:
# it is byte-identical to tests/, and at top level it trips the CRAN
# "Non-standard file/directory found at top level" NOTE.
punycoder-tests/

# RStudio files
.Rproj.user/

